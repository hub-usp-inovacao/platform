:5000

handle /cms/* {
  reverse_proxy payload:3000
}

handle /__nextjs_font/* {
  reverse_proxy payload:3000
}

handle /api/catalog/* {
  uri strip_prefix /api/catalog
  reverse_proxy catalogapp:8080
}

handle /api/journey/* {
  uri strip_prefix /api
  reverse_proxy catalogapp:8080
}

handle_path /api/v2/* {
  reverse_proxy catalogapp:8080
}

handle_path /api/* {
  uri strip_prefix /api
  reverse_proxy backdev:3000
}

reverse_proxy /* frontdev:3000
