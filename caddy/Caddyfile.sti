:5000

redir /cms /cms/admin
redir /cms/ /cms/admin

handle_path /cms/* {
  reverse_proxy payload:3000
}

handle /__nextjs_font/* {
  reverse_proxy payload:3000
}

handle_path /catalog/* {
  uri strip_prefix /catalog
  reverse_proxy catalogapp:8080
}

handle_path /v2/* {
  reverse_proxy catalogapp:8080
}

handle_path /* {
  reverse_proxy backend:3000
}