DATABASE_URL=mongodb://127.0.0.1/your-database-name
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Segredo compartilhado para autenticar o proxy de atualização com o backend; deve ser igual ao de server/.env
HUB_REFRESH_SECRET=

# URL interna do serviço de catálogo Kotlin (opcional; padrão http://catalogapp:8080)
CATALOG_INTERNAL_URL=
